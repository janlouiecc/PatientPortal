@page
@model PatientPortal.Web.Pages.SearchModel
@{
    ViewData["Title"] = "Search Patients";
}

<div class="bg-white p-8 rounded-lg shadow-sm border border-slate-200">
    <h2 class="text-xl font-semibold text-slate-900 mb-6">Patient Search</h2>
    
    <form method="get" class="flex gap-4 mb-8">
        <input type="text" asp-for="Query" placeholder="Search by MRN, First or Last Name" 
               class="flex-1 border border-slate-300 rounded-md px-4 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500" />
        <button type="submit" class="bg-slate-900 hover:bg-slate-800 text-white font-medium py-2 px-6 rounded-md transition-colors">
            Search
        </button>
    </form>

    @if (Model.HasSearched)
    {
        if (Model.Results.Any())
        {
            <div class="overflow-x-auto border border-slate-200 rounded-md">
                <table class="min-w-full divide-y divide-slate-200">
                    <thead class="bg-slate-50">
                        <tr>
                            <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-slate-500 uppercase tracking-wider">MRN</th>
                            <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-slate-500 uppercase tracking-wider">Patient Name</th>
                            <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-slate-500 uppercase tracking-wider">DOB</th>
                            <th scope="col" class="px-6 py-3 text-right text-xs font-medium text-slate-500 uppercase tracking-wider">Action</th>
                        </tr>
                    </thead>
                    <tbody class="bg-white divide-y divide-slate-200">
                        @foreach(var p in Model.Results)
                        {
                            <tr class="hover:bg-slate-50">
                                <td class="px-6 py-4 whitespace-nowrap text-sm text-slate-600">@p.MRN</td>
                                <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-slate-900">@p.LastName, @p.FirstName</td>
                                <td class="px-6 py-4 whitespace-nowrap text-sm text-slate-600">@p.DOB.ToString("MMM dd, yyyy")</td>
                                <td class="px-6 py-4 whitespace-nowrap text-right text-sm font-medium">
                                    <a asp-page="/PatientDetails" asp-route-id="@p.PatientId" class="text-blue-600 hover:text-blue-900">View Details</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            @if (Model.TotalPages > 1)
                {
                    <div class="flex justify-between items-center mt-4 px-2">
                        <div class="text-sm text-slate-600">
                            Page @Model.PageNumber of @Model.TotalPages
                        </div>
                        <div class="flex gap-2">
                            @if (Model.PageNumber > 1)
                            {
                                <a asp-page="/Search" asp-route-Query="@Model.Query" asp-route-PageNumber="@(Model.PageNumber - 1)" 
                                   class="px-3 py-1 border border-slate-300 rounded-md text-sm font-medium text-slate-700 hover:bg-slate-50">Previous</a>
                            }
                            @if (Model.PageNumber < Model.TotalPages)
                            {
                                <a asp-page="/Search" asp-route-Query="@Model.Query" asp-route-PageNumber="@(Model.PageNumber + 1)" 
                                   class="px-3 py-1 border border-slate-300 rounded-md text-sm font-medium text-slate-700 hover:bg-slate-50">Next</a>
                            }
                        </div>
                    </div>
                }
        }
        else
        {
            <div class="p-4 bg-slate-50 border border-slate-200 rounded-md text-slate-600 text-sm">
                No matching patient records found.
            </div>
        }
    }
</div>